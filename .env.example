# Copy this file to .env and fill in real values. .env itself is gitignored
# and never committed; this example file is, so the required variable names
# are documented without exposing any real secret.

# Required to run the live Groq narration tests (tests/test_narrate.py,
# tests/test_prompt_injection_resistance.py) and to use reasoning/narrate.py
# against the real API. Get a key at https://console.groq.com/keys.
GROQ_API_KEY=
